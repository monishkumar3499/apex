# ---------------------------------------------------------------------------
# APEX environment
# Copy to `.env` inside frontend/ and fill in. Next.js loads it for both the
# client and server runtimes.
#
# `GET /api/health` reports anything missing or degraded, including whether the
# public credentials actually made it into the browser bundle.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API. The service-role key bypasses RLS: server-side only,
# never expose it to the browser and never prefix it with NEXT_PUBLIC_.
#
# IMPORTANT for Docker: the two NEXT_PUBLIC_ values are compiled into the
# browser bundle at BUILD time. Setting them only via `docker run --env-file`
# is too late — there is nothing left to substitute, so the bundle ships
# `undefined` and sign-in silently does nothing while every server route keeps
# working. Pass them as build args (the Dockerfile enforces this).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Public origin (required behind a proxy) -------------------------------
# The origin a browser uses to reach APEX, e.g. "https://apex.example.com".
#
# Behind the reverse proxy on EC2 the app sees a plain-HTTP request on an
# internal host, so it cannot derive its own public URL. Without this, OAuth
# redirects are built from `x-forwarded-*` headers — which works when the proxy
# sets them, and sends learners to http://localhost:3000 when it does not.
#
# It also has to match the callback URL registered under Supabase →
# Authentication → URL Configuration: <APP_ORIGIN>/auth/callback
APP_ORIGIN="http://localhost:3000"

# --- Google Gemini (required) ----------------------------------------------
# https://aistudio.google.com/apikey — used for the structured tier
# (plan blueprints and drill questions), where JSON reliability matters most.
GEMINI_API_KEY="AIza..."

# --- OpenRouter (required) -------------------------------------------------
# https://openrouter.ai/keys — used for the nano and chat tiers.
OPENROUTER_API_KEY="sk-or-v1-..."
SITE_URL="http://localhost:3000"
SITE_NAME="APEX"

# --- Model tiers -----------------------------------------------------------
# Routed by job size, not by agent name:
#   NANO       classification + JSON repair   (cheap, fast, high volume)
#   STRUCTURED plan blueprints + drill cards  (needs reliable JSON)
#   CHAT       the coach                      (needs fluency and streaming)
#
# Each variable accepts a COMMA-SEPARATED FALLBACK CHAIN, tried in order. A
# single value is promoted to the head of the built-in chain rather than
# replacing it, so overriding the primary model never discards its fallbacks.
#
# Every chain crosses providers on purpose. Free tiers do not fail one model at
# a time: a Google-side quota exhaustion takes out every Gemini slug at once, so
# a chain of three Gemini models is a chain of one.
#
# Two rules when changing these:
#   1. Verify the slug resolves: GET /api/health?models=1 probes all three.
#      Providers retire slugs (openai/gpt-oss-120b:free now 404s).
#   2. Prefer a model that does not emit reasoning tokens, or that lets them be
#      turned off. Reasoning is billed against the same max_tokens budget as the
#      answer, so a reasoning model can spend the whole budget thinking and
#      return nothing. Some free slugs also leak the reasoning trace into
#      `content` (nvidia/nemotron-3.5-lightning:free opens with "Here's a
#      thinking process:") — the OpenRouter client detects and rejects that.
NANO_MODEL="minimax/minimax-m3:free"
STRUCTURED_MODEL="gemini-2.5-flash"
CHAT_MODEL="minimax/minimax-m3:free"

# --- Upstream pacing (optional) --------------------------------------------
# How fast requests are allowed to leave, per provider. The defaults are tuned
# for free tiers, where the published limits are low and the effective ones are
# lower — a plan build naturally bursts (unit searches, blueprint shards), and a
# burst is what trips a per-minute limit. Raise these on a paid key.
#
# Free gemini-2.5-flash allows roughly 10 requests/minute, and one build spends
# four on the blueprint (an outline plus three concurrent topic shards).
# AI_MAX_CONCURRENCY_GEMINI="4"
# AI_MIN_INTERVAL_GEMINI_MS="120"
# AI_MAX_CONCURRENCY_OPENROUTER="2"
# AI_MIN_INTERVAL_OPENROUTER_MS="350"

# --- Resource discovery ----------------------------------------------------
# Both optional, but a plan built without them has far weaker material.
# YouTube: quota is 10,000 units/day and search.list costs 100 per call, so a
# plan build uses roughly 1,500–2,500 units. /api/health reports if either is
# missing.
YOUTUBE_API_KEY="your-google-api-key"
TAVILY_API_KEY="tvly-..."

# --- Local development -----------------------------------------------------
# DEMO_MODE bypasses auth entirely and pins every request to DEMO_USER_ID. That
# user row must exist in auth.users (see database/seed-demo-user.sql). Never
# enable this in a deployed environment — and note that with it on, the OAuth
# path is never exercised, so sign-in bugs stay invisible.
NEXT_PUBLIC_DEMO_MODE="false"

LOG_LEVEL="info"
