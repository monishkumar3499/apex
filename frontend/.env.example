# ---------------------------------------------------------------------------
# APEX environment
# Copy to `.env` inside frontend/ and fill in. Next.js loads it for both the
# client and server runtimes.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API. The service-role key bypasses RLS: server-side only,
# never expose it to the browser and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- OpenRouter (required) -------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
SITE_URL="http://localhost:3000"
SITE_NAME="APEX"

# --- Model tiers -----------------------------------------------------------
# Routed by job size, not by agent name.
#   NANO       classification + JSON repair (cheap, fast, high volume)
#   STRUCTURED plan blueprints + drill questions (needs reliable JSON)
#   CHAT       the coach (needs fluency and streaming)
#
# All three currently point at one model because it is the only free slug that
# reliably returns JSON without a reasoning trace. Split them again the moment
# a cheaper nano-tier model is available -- the tiers exist for that reason.
#
# Two rules when changing these:
#   1. Verify the slug resolves: GET /api/health?models=1 probes all three.
#      OpenRouter retires slugs (openai/gpt-oss-120b:free now 404s).
#   2. Prefer a model that does NOT emit reasoning tokens. Reasoning is billed
#      against the same max_tokens budget as the answer, so a reasoning model
#      can spend the whole budget thinking and return nothing.
NANO_MODEL="minimax/minimax-m3:free"
STRUCTURED_MODEL="minimax/minimax-m3:free"
CHAT_MODEL="minimax/minimax-m3:free"

# --- Resource discovery ----------------------------------------------------
# Both optional, but a plan built without them has far weaker material.
# YouTube: quota is 10,000 units/day and search.list costs 100 per call, so a
# plan build uses roughly 900–1,800 units. /api/health reports if either is missing.
YOUTUBE_API_KEY="your-google-api-key"
TAVILY_API_KEY="tvly-..."

# --- Local development -----------------------------------------------------
# DEMO_MODE bypasses auth and pins every request to DEMO_USER_ID. That user row
# must exist in auth.users. Never enable this in a deployed environment.
NEXT_PUBLIC_DEMO_MODE="true"

LOG_LEVEL="info"
